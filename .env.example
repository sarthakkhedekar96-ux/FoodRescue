# FoodRescue Environment Variables Template
# Copy this file to .env (which is ignored by Git) or export variables in your shell.
# IMPORTANT: If your password contains special characters (: / ? # [ ] @ ! $ & ' ( ) * + , ; = %),
# they must be URL-encoded (e.g. '@' -> '%40', '#' -> '%23', '+' -> '%2B').

# Database credentials
MONGODB_PASSWORD=your_mongodb_atlas_password_here

# JWT Signing Secret (MUST be at least 32 characters / 256 bits)
JWT_SECRET=your_minimum_32_character_jwt_secret_key_here

# Initial Admin Bootstrap (Optional: bootstrapped on startup if no admin exists)
ADMIN_EMAIL=your_admin_email_here
ADMIN_PASSWORD=your_secure_admin_password_here

# Optional: Seeder Password for seeded demo users if app.seeder.enabled=true
SEEDER_PASSWORD=your_seeder_password_here
